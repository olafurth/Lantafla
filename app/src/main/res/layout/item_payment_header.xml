<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/colorPrimary">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="6dp"
        android:paddingStart="4dp">

        <TextView
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="@string/col_month"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="11sp"
            android:gravity="center" />

        <TextView
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:text="@string/col_payment"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="11sp"
            android:gravity="end"
            android:paddingEnd="6dp" />

        <TextView
            android:layout_width="82dp"
            android:layout_height="wrap_content"
            android:text="@string/col_interest"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="11sp"
            android:gravity="end"
            android:paddingEnd="6dp" />

        <TextView
            android:layout_width="82dp"
            android:layout_height="wrap_content"
            android:text="@string/col_principal"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="11sp"
            android:gravity="end"
            android:paddingEnd="6dp" />

        <TextView
            android:id="@+id/colInflation"
            android:layout_width="82dp"
            android:layout_height="wrap_content"
            android:text="@string/col_inflation"
            android:textColor="#FFFF00"
            android:textStyle="bold"
            android:textSize="11sp"
            android:gravity="end"
            android:paddingEnd="6dp"
            android:visibility="gone" />

        <TextView
            android:layout_width="96dp"
            android:layout_height="wrap_content"
            android:text="@string/col_balance"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="11sp"
            android:gravity="end"
            android:paddingEnd="6dp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FFD600" />

</LinearLayout>
